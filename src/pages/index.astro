---
import Layout from "../layouts/Layout.astro";
import image from "../assets/images/barden2.jpg";
import { Icon } from "astro-icon/components";

const socials = [
    { href: "https://github.com/officialbarden", icon: "simple-icons:github" },
    { href: "https://modrinth.com/user/barden", icon: "simple-icons:modrinth" },
];
---

<Layout title="barden | website">
    <main class="m-auto w-full md:px-100 md:py-35">
        <div class="flex flex-row gap-ui items-center p-ui">
            <img class="w-30" src={image.src} />
            <div class="flex flex-col md:text-2xl w-full gap-ui">
                <h1 class="flex-1">barden</h1>
                <!-- Socials -->
                <div class="flex gap-1 text-[20px]">
                    {socials.map((socialLink) => (
                        <a
                            target="_blank"
                            rel="noopener noreferrer"
                            href={socialLink.href}
                        >
                            <Icon name={socialLink.icon} />
                        </a>
                    ))}
                </div>
            </div>
        </div>
    </main>
</Layout>
