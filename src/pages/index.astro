---
import Layout from "../layouts/Layout.astro";

// components
import AboutMeWidget from '../components/Widgets/AboutMe.astro'
import GeneratorWidget from '../components/Widgets/Generator.astro'
import DocumentationWidget from '../components/Widgets/Documentation.astro'

// texts
import AboutMeText from '../components/Texts/AboutMe.mdx'

---

<Layout title="barden | website">
    <main class="min-h-0 flex flex-col m-auto">
        <div class="my-5">
            <AboutMeWidget />
        </div>
        
        <!-- ABOUT ME -->
        <div class="flex flex-col p-ui">
            <h1 class="text-white/50">About Me</h1>
            <p class="text-white/50">
                <div class="rendered-mdx">
                    <AboutMeText />
                </div>
            </p>
        </div>
        
        <!-- GENERATORS -->
        <div class="flex flex-col p-ui">
            <h1 class="text-white/50">Generators</h1>
            <div class="flex flex-col text-white/50">
                <GeneratorWidget />
            </div>
        </div>

        <!-- DOCS -->
        <div class="flex flex-col p-ui">
            <h1 class="text-white/50">Documentation & Tutorials</h1>
            <div class="flex flex-col text-white/50">
                <DocumentationWidget />
            </div>
        </div>

        <!-- BLOGS -->
        <!-- <div class="flex flex-col p-ui">
            <h1 class="text-white/50">Blogs</h1>
            <div class="flex flex-col">
            </div>
        </div> -->
    </main>
</Layout>
