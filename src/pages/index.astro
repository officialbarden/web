---
import Layout from "../layouts/Layout.astro";

// components
import AboutMeWidget from '../components/Widgets/AboutMe.astro'
import GeneratorWidget from '../components/Widgets/Generator.astro'
import DocumentationWidget from '../components/Widgets/Documentation.astro'

// texts
import AboutMeText from '../components/Texts/AboutMe.mdx'

---

<Layout title="barden | website">
    <main class="m-auto w-full md:px-100 md:py-35">
        <AboutMeWidget />

        <!-- ABOUT ME -->
        <div class="flex flex-col p-ui">
            <h1 class="">About Me</h1>
            <p class="text-white">
                <div class="rendered-mdx">
                    <AboutMeText />
                </div>
            </p>
        </div>
        
        <!-- GENERATORS -->
        <div class="flex flex-col p-ui">
            <h1>Generators</h1>
            <div class="flex flex-col">
                <GeneratorWidget />
            </div>
        </div>

        <!-- DOCS -->
        <div class="flex flex-col p-ui">
            <h1>Documentation / Tutorials</h1>
            <div class="flex flex-col">
                <DocumentationWidget />
            </div>
        </div>

        <!-- BLOGS -->
        <div class="flex flex-col p-ui">
            <h1>Blogs</h1>
            <div class="flex flex-col">
            </div>
        </div>
    </main>
</Layout>
