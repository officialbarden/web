---
//import image from "../../assets/images/barden2.jpg";
import { Icon } from "astro-icon/components";

const image = "https://api.lanyard.rest/1209176307837964328.png";

const socials = [
    { href: "https://github.com/officialbarden", icon: "simple-icons:github" },
    { href: "https://modrinth.com/user/barden", icon: "simple-icons:modrinth" },
    { href: "https://www.youtube.com/@bardenslab", icon: "simple-icons:youtube" },
    { href: "https://www.discord.gg/2ujVhE2s2e", icon: "simple-icons:discord" },
];
---

<div class="flex flex-row rounded-full gap-ui">
    <img class="w-30 rounded-full transition-all hover:border-green-700 duration-300 border-4 border-transparent" src={image} />
    <div class="flex flex-col md:text-2xl justify-self-center w-full h-full py-5">
        <h1 class="px-2">barden <span class="text-[15px]">(he/him)</span></h1>
        <!-- Socials -->
        <div class="flex gap-1 text-[20px] w-fit hover:bg-white/10 p-2 rounded-full">
            {socials.map((socialLink) => (
                <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href={socialLink.href}
                >
                    <Icon name={socialLink.icon} />
                </a>
            ))}
        </div>
    </div>
</div>